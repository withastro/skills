# Provider keys for live evaluations (scripts/eval-matrix.mjs).
# Copy to .env.local and fill in the keys you have. .env.local is gitignored.
# Entries in evals/matrix.json whose key is missing are skipped.

# Claude Code entries
ANTHROPIC_API_KEY=

# Codex entries
OPENAI_API_KEY=

# OpenCode entries (via OpenRouter)
OPENROUTER_API_KEY=
