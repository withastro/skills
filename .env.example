# Provider keys for the local evaluation scripts (scripts/eval-matrix.mjs and
# scripts/dedup.mjs). Copy to .env.local and fill in the keys you have.
# .env.local is gitignored. Matrix entries whose key is missing are skipped.

# Claude Code entries
ANTHROPIC_API_KEY=

# Codex entries; also used for Tier 2 deduplication when set
OPENAI_API_KEY=

# OpenCode entries (via OpenRouter); used for Tier 2 when OPENAI_API_KEY is not set
OPENROUTER_API_KEY=
