{
  "$comment": "Harness x model matrix for scripts/eval-matrix.mjs. Each entry is one `skillevaluator tier3 evaluate` run with both arms (with and without the skill). Edit this list to change the models. `route` selects how the run reaches the model and which key it needs (see `routes`). `model` is the ID the agent is given; `judgeModel` grades the judged dimensions and is fixed per route so the small and frontier rows of a harness are judged alike.",
  "envMode": "docker",
  "attempts": 3,
  "regressionTolerance": 0.05,
  "routes": {
    "anthropic": {
      "provider": "anthropic",
      "key": "ANTHROPIC_API_KEY",
      "judgeModel": "claude-opus-5-5"
    },
    "openai": {
      "provider": "openai",
      "key": "OPENAI_API_KEY",
      "judgeModel": "gpt-6.2-sol"
    },
    "openrouter": {
      "provider": "openai-compatible",
      "key": "OPENROUTER_API_KEY",
      "baseUrl": "https://openrouter.ai/api/v1",
      "judgeModel": "anthropic/claude-opus-5.5"
    }
  },
  "entries": [
    { "id": "claude-code-haiku", "agent": "claude-code", "route": "anthropic", "model": "claude-haiku-5-5", "tier": "small" },
    { "id": "claude-code-opus", "agent": "claude-code", "route": "anthropic", "model": "claude-opus-5-5", "tier": "frontier" },
    { "id": "codex-luna", "agent": "codex", "route": "openai", "model": "gpt-6-luna", "tier": "small" },
    { "id": "codex-sol", "agent": "codex", "route": "openai", "model": "gpt-6.2-sol", "tier": "frontier" },
    { "id": "opencode-gemini-hydrogen", "agent": "opencode", "route": "openrouter", "model": "google/gemini-4-hydrogen", "tier": "small" },
    { "id": "opencode-gemini-neon", "agent": "opencode", "route": "openrouter", "model": "google/gemini-4-neon", "tier": "frontier" }
  ]
}
