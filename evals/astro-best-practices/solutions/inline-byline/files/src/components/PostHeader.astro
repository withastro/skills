---
interface Props {
  title: string;
  author: string;
  date: Date;
}

const { title, author, date } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<header class="post-header">
  <h1>{title}</h1>
  <p class="byline">
    By{" "}<strong>{author}</strong>{" "}on{" "}<time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time>
  </p>
</header>
