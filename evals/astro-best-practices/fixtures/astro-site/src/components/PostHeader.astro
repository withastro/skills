---
interface Props {
  title: string;
  author: string;
  date: Date;
}

const { title, author, date } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<header class="post-header">
  <h1>{title}</h1>
</header>
